<Robo>
  <Foundation name="Demo" from="RoboFoundation"/>
  <FoundationUse name="Demo"/>

  <TitleBar title="Robo"/>

  <Heading level="1" align="center">Robo</Heading>
  <Paragraph align="center">
    This page is Demo.xml, compiled to C++, then compiled for the browser.
  </Paragraph>

  <H2>Text</H2>
  <Paragraph selectable="true">
    Paragraphs wrap, align, and share the text engine with headings. This one can be selected and copied. Edit Demo.xml and run RunDemo.ps1 to rebuild the page.
  </Paragraph>

  <Separator size="sm"/>

  <H2>Buttons</H2>
  <Button variant="filled">Continue</Button>
  <Button variant="tinted">Not now</Button>
  <Button variant="gray">Secondary</Button>
  <Button variant="plain">Plain</Button>
  <Button variant="destructive">Delete</Button>
  <Button disabled="true">Unavailable</Button>
  <IconButton icon="Close" label="Close"/>
  <IconButton icon="Plus" label="Add" variant="primary"/>

  <Separator>or continue with</Separator>
  <Separator variant="subtle"/>
  <Separator variant="dashed" tone="brand"/>
  <Separator variant="dotted"/>
  <Separator variant="fade"/>
  <Flexbox direction="row" align="stretch" gap="{space.5}">
    <Button variant="plain">Archive</Button>
    <Separator orientation="vertical" flush="true"/>
    <Button variant="plain">Report</Button>
  </Flexbox>

  <Separator size="sm"/>

  <H2>Inputs</H2>
  <Paragraph>Click a field and type. Escape leaves the field.</Paragraph>
  <Input variant="filled" placeholder="Full name" width="100%" />
  <Input variant="bordered" placeholder="Email address" width="100%" />
  <Input variant="plain" placeholder="Search" width="100%" />

  <Separator size="sm"/>

  <H2>Flex</H2>
  <Flexbox direction="row" justify="space-between" align="center" gap="{space.3}" width="100%">
    <Button>Left</Button>
    <Button variant="tinted">Middle</Button>
    <Button>Right</Button>
  </Flexbox>

  <Separator size="sm"/>

  <H2>Grid</H2>
  <Grid columns="1fr 1fr" gap="{space.3}" width="100%">
    <Button>A</Button>
    <Button variant="gray">B</Button>
    <Button variant="tinted">C</Button>
    <Button>D</Button>
  </Grid>

  <Separator size="sm"/>

  <H2>Position</H2>
  <Position width="100%" height="{space.10}" background="{color.text.primary}" cornerRadius="{radius.lg}">
    <Button left="16" top="16">Top left</Button>
    <Button right="16" bottom="16" variant="tinted">Bottom right</Button>
  </Position>

  <Separator size="sm"/>

  <H2>Container</H2>
  <Paragraph>Wheel, drag, or use the arrow keys. The cursor stays an arrow.</Paragraph>
  <Container height="{space.10}" gap="{space.3}" padding="{space.4}" background="{color.bg.primary}" cornerRadius="{radius.lg}" borderColor="{color.border.subtle}" borderWidth="1" variant="thin" arrows="true" autoHide="false">
    <H3>Inside the container</H3>
    <Paragraph selectable="true">The first row of a clipped, scrolling region.</Paragraph>
    <Paragraph>Buttons and fields inside stay interactive.</Paragraph>
    <Button>Tap me</Button>
    <Input placeholder="A field inside the scroll region" width="100%" />
    <Paragraph>Keep going. The thumb tracks how much is left.</Paragraph>
    <Paragraph>Another row, so the region actually overflows.</Paragraph>
    <Paragraph>Almost at the end of the scroll range.</Paragraph>
    <Button variant="tinted">Last control</Button>
  </Container>

  <Separator size="sm"/>

  <H2>Brand</H2>
  <Flexbox direction="row" align="center" gap="{space.5}">
    <BrandLogo />
    <BrandLogo variant="icon" />
    <BrandLogo variant="text" />
    <BrandLogo variant="lockup" />
  </Flexbox>

  <Separator size="sm"/>

  <H2>Theme</H2>
  <ThemeToggle />
  <Flexbox direction="row" align="center" wrap="wrap" gap="{space.4}">
    <ThemeToggle variant="compact" />
    <ThemeToggle variant="labels" />
    <ThemeToggle variant="icons" />
    <ThemeToggle variant="switch" />
    <ThemeToggle variant="compact" disabled="true" />
  </Flexbox>

  <Separator size="sm"/>

  <H2>Theme switch</H2>
  <Keyframes name="shootingStar" duration="2s" easing="linear" iteration="infinite">
    <Keyframe at="0" x="0" y="0" opacity="1" rotate="45"/>
    <Keyframe at="1" x="150" y="150" opacity="0" rotate="45"/>
  </Keyframes>
  <Keyframes name="shootingStarSlow" duration="3s" easing="linear" iteration="infinite">
    <Keyframe at="0" x="0" y="0" opacity="1" rotate="45"/>
    <Keyframe at="1" x="150" y="150" opacity="0" rotate="45"/>
  </Keyframes>
  <Keyframes name="meteor" duration="4s" easing="linear" iteration="infinite">
    <Keyframe at="0" y="0" scale="1" opacity="1"/>
    <Keyframe at="1" y="150" scale="0.3" opacity="0"/>
  </Keyframes>
  <Keyframes name="twinkle" duration="1s" easing="ease-in-out" iteration="infinite">
    <Keyframe at="0" opacity="0.3" scale="1"/>
    <Keyframe at="0.5" opacity="1" scale="1.2"/>
    <Keyframe at="1" opacity="0.3" scale="1"/>
  </Keyframes>
  <Keyframes name="auroraWave" duration="8s" easing="linear" iteration="infinite">
    <Keyframe at="0" x="-84.375"/>
    <Keyframe at="1" x="84.375"/>
  </Keyframes>
  <Keyframes name="cometMove" duration="4s" easing="linear" iteration="infinite">
    <Keyframe at="0" x="0" y="0" opacity="0" scale="1" rotate="-45"/>
    <Keyframe at="0.1" x="20" y="20" opacity="1" scale="0.92" rotate="-45"/>
    <Keyframe at="0.9" x="180" y="180" opacity="1" scale="0.28" rotate="-45"/>
    <Keyframe at="1" x="200" y="200" opacity="0" scale="0.2" rotate="-45"/>
  </Keyframes>
  <Keyframes name="cometMoveSlow" duration="6s" easing="linear" iteration="infinite">
    <Keyframe at="0" x="0" y="0" opacity="0" scale="1" rotate="-45"/>
    <Keyframe at="0.1" x="20" y="20" opacity="1" scale="0.92" rotate="-45"/>
    <Keyframe at="0.9" x="180" y="180" opacity="1" scale="0.28" rotate="-45"/>
    <Keyframe at="1" x="200" y="200" opacity="0" scale="0.2" rotate="-45"/>
  </Keyframes>
