  <H2>Theme icon</H2>
  <Flexbox direction="row" align="center" wrap="wrap" gap="{space.4}">
    <ThemeIconToggle />
    <ThemeIconToggle variant="subtle" />
    <ThemeIconToggle variant="outline" />
    <ThemeIconToggle variant="pair" />
    <ThemeIconToggle variant="segmented" />
    <ThemeIconToggle variant="split" />
    <ThemeIconToggle variant="pair" size="sm" />
    <ThemeIconToggle variant="pair" disabled="true" />
  </Flexbox>

  <Separator size="sm"/>

  <H2>Icons</H2>
  <Paragraph>Pack icons resize and recolor. Their paths stay in the pack.</Paragraph>
  <Flexbox direction="row" align="center" gap="{space.4}">
    <Search size="28" color="{color.brand.primary}" />
    <Plus size="28" color="{color.text.primary}" />
    <Check size="28" color="{color.success}" />
    <Close size="28" color="{color.danger}" />
    <Home size="28" />
    <Heart size="28" color="{color.danger}" />
    <FlagFrance width="{space.6}" height="{space.5}" />
    <FlagJapan width="{space.6}" height="{space.5}" />
    <FlagGermany width="{space.6}" height="{space.5}" />
  </Flexbox>

  <Separator size="sm"/>

  <H2>SVG</H2>
  <Paragraph>This graphic is written in the page XML.</Paragraph>
