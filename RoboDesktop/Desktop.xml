<Robo padding="0">
  <Foundation name="Desktop" from="RoboFoundation"/>
  <FoundationUse name="Desktop"/>

  <Desktop>
    <Background color="{color.bg.primary}" src="Assets/Background.mp4"/>
    <TopBarMenu app="RoboticelaOS" clock="Tue 9:41 AM" appearance="light">
      <TopBarMenuItem label="File"/>
      <TopBarMenuItem label="Edit"/>
      <TopBarMenuItem label="View"/>
      <TopBarMenuItem label="Go"/>
      <TopBarMenuItem label="Window"/>
      <TopBarMenuItem label="Help"/>
    </TopBarMenu>
    <ContextMenu appearance="light">
      <ContextMenuItem label="New Folder" icon="Folder" shortcut="Shift Command N"/>
      <ContextMenuItem label="Get Info" icon="Info" shortcut="Command I"/>
      <ContextMenuItem label="Change Desktop Background…" icon="Image"/>
      <ContextMenuSeparator/>
      <ContextMenuItem label="Use Stacks" checkable="true"/>
      <ContextMenuItem label="Sort By">
        <ContextMenuItem label="Name"/>
        <ContextMenuItem label="Kind"/>
        <ContextMenuItem label="Date Modified"/>
        <ContextMenuItem label="Date Created"/>
        <ContextMenuItem label="Size"/>
        <ContextMenuItem label="Tags"/>
      </ContextMenuItem>
      <ContextMenuSeparator/>
      <ContextMenuItem label="Clean Up"/>
      <ContextMenuItem label="Clean Up By">
        <ContextMenuItem label="Name"/>
        <ContextMenuItem label="Kind"/>
        <ContextMenuItem label="Date Modified"/>
        <ContextMenuItem label="Date Created"/>
        <ContextMenuItem label="Size"/>
        <ContextMenuItem label="Tags"/>
      </ContextMenuItem>
      <ContextMenuSeparator/>
      <ContextMenuItem label="Show View Options" shortcut="Command J"/>
    </ContextMenu>
    <SelectionArea fontSize="12" fontWeight="400" color="#FFFFFF" align="center" lineHeight="1.25" letterSpacing="0" wrap="true" maxWidth="100" maxLines="2" shadowX="0" shadowY="1" shadowBlur="2" shadowColor="#000000D9" iconGap="5" selectionRadius="4" selectionColor="#007AFF">
      <SelectionAreaItem label="DevKit" x="24" y="24" open="DevKit"/>
    </SelectionArea>
  </Desktop>
</Robo>
